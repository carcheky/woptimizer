# =============================================================================
# woptimizer .gitignore
# Excluye datos del usuario, artefactos generados y archivos temporales.
# =============================================================================

# Datos de usuario (perfiles, sesiones, lista de procesos matados)
profiles.json
saved_processes.json

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# PyInstaller — artefactos de build (regenerar con build.bat)
build/
dist/
*.spec

# MkDocs — output generado (regenerar con mkdocs build)
site/

# Editores / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Windows / Office
Thumbs.db
desktop.ini
*.lnk

# Logs
*.log
logs/

# Outputs temporales / tests
.cache/
tmp/

# Backups de tests (pueden contener datos de usuario reales: profiles.json.testbak*)
*.testbak*

# Dependencias instaladas
node_modules/

# Archivos legacy eliminados (para que git no los re-trackee si se recrean)
process_manager.pyw
ProcessManager.vbs
ProcessManager.bat
ProcessManager.ps1
sync_pyw.py
miniapps/

scratch/
*.bak
